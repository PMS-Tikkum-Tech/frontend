# Local: http://127.0.0.1:3001
# Production KIKOST: https://api.kikost.com
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Isi URL/path gambar QRIS BSI, contoh: /payments/qris-bsi.png
NEXT_PUBLIC_BSI_QRIS_IMAGE_URL=

# Booking frontend versioning
NEXT_PUBLIC_BOOKING_V2_ENABLED=true
NEXT_PUBLIC_BOOKING_DEFAULT_VERSION=v1
NEXT_PUBLIC_SHOW_BOOKING_VERSION_SELECTOR=true
NEXT_PUBLIC_SHOW_BOOKING_VERSION_BADGE=true
VITE_BOOKING_V2_ENABLED=true
VITE_BOOKING_DEFAULT_VERSION=v1
VITE_SHOW_BOOKING_VERSION_SELECTOR=true
VITE_SHOW_BOOKING_VERSION_BADGE=true

# Firebase Auth
# Aktifkan sign-in method Email/Password dan Phone di Firebase Authentication.
# Project ID ini harus sama dengan FIREBASE_PROJECT_ID di backend.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Backward-compatible alias lama untuk Phone Auth. Prefer pakai env unified di atas.
NEXT_PUBLIC_FIREBASE_PHONE_API_KEY=
NEXT_PUBLIC_FIREBASE_PHONE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PHONE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PHONE_APP_ID=
